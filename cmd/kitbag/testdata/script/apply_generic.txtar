env KITBAG_CONFIG=$WORK/machine.toml
env KITBAG_HOST=test
# Public sync: a generic
# agent, a [[files]] entry and the separate Git include step. HOME and
# GIT_CONFIG_GLOBAL are the harness's throwaway ones; the repository lives
# below HOME so a "~/" include can name it.
agentdirs .amp .agent-browser
cp $WORK/.gitconfig $HOME/.gitconfig
env GIT_CONFIG_GLOBAL=$HOME/.gitconfig
cp $WORK/local.json $HOME/.agent-browser/config.json
exec kitbag sync --no-pull
! stderr .
stdout '^write .*/home/\.amp/AGENTS\.md$'
stdout '^materialize .*/home/\.amp/skills/review$'
! stdout 'skills/notes'
stdout '^materialize .*/home/\.amp/commands/deploy\.md$'
stdout -count=1 '^backup '
stdout '^backup .*/home/\.agent-browser/config\.json$'
stdout '^materialize .*/home/\.agent-browser/config\.json$'
stdout -count=1 '^include '
stdout '^include .*/home/src/config/git/agent\.gitconfig$'
cmp $HOME/.amp/AGENTS.md $WORK/want-agents.md
linktarget $HOME/.amp/skills/review $HOME/src/config/skills/review
linktarget $HOME/.amp/commands/deploy.md $HOME/src/config/commands/deploy.md
linktarget $HOME/.agent-browser/config.json $HOME/src/config/agent-browser/config.json
# The shell expands the glob; more than one backup makes this cp fail.
exec sh -c 'cp "$HOME"/.agent-browser/config.json.before-kitbag.* "$WORK"/original'
cmp $WORK/original $WORK/local.json
exec git config --global --get-all include.path
stdout -count=1 'agent\.gitconfig'

# Repeat: nothing to do, no second backup and no duplicate include.
exec kitbag sync --no-pull
nooutput
exec sh -c 'cp "$HOME"/.agent-browser/config.json.before-kitbag.* "$WORK"/original'
exec git config --global --get-all include.path
stdout -count=1 'agent\.gitconfig'

# A dotfile-managed (chezmoi) config already including "~/..." is left alone.
exec ln -s $HOME/dotfiles/tilde.gitconfig $HOME/chezmoi.gitconfig
env GIT_CONFIG_GLOBAL=$HOME/chezmoi.gitconfig
exec kitbag sync --no-pull
nooutput
cmp $HOME/dotfiles/tilde.gitconfig $WORK/want-tilde.gitconfig

linktarget $HOME/chezmoi.gitconfig $HOME/dotfiles/tilde.gitconfig

# A linked config without the include is never rewritten through the link.
exec ln -s $HOME/dotfiles/plain.gitconfig $HOME/linked.gitconfig
env GIT_CONFIG_GLOBAL=$HOME/linked.gitconfig
execstatus 1 kitbag sync --no-pull
stderr 'linked\.gitconfig is a symbolic link .*add include\.path .*/agent\.gitconfig there'
! stdout .
linktarget $HOME/linked.gitconfig $HOME/dotfiles/plain.gitconfig
cmp $HOME/dotfiles/plain.gitconfig $WORK/want-plain.gitconfig

# Nor is a read-only one.
env GIT_CONFIG_GLOBAL=$HOME/dotfiles/plain.gitconfig
chmod 0444 $HOME/dotfiles/plain.gitconfig
execstatus 1 kitbag sync --no-pull
stderr 'plain\.gitconfig is read-only'
cmp $HOME/dotfiles/plain.gitconfig $WORK/want-plain.gitconfig

# Machine copy policy applies to generic skills/commands and arbitrary files.
env GIT_CONFIG_GLOBAL=$HOME/.gitconfig
exec kitbag sync --no-pull --mode copy
! stderr .
cmp $HOME/.amp/skills/review/SKILL.md $HOME/src/config/skills/review/SKILL.md
cmp $HOME/.agent-browser/config.json $HOME/src/config/agent-browser/config.json
exec test ! -L $HOME/.amp/skills/review
exec test ! -L $HOME/.amp/commands/deploy.md
exec test ! -L $HOME/.agent-browser/config.json
exec kitbag sync --no-pull --mode copy
nooutput

-- home/src/config/kitbag.toml --
schema = 1

[instructions]
source = "global/AGENTS.md"
hosts = "hosts/{host}.md"

[skills]
dirs = ["skills"]

[commands]
dir = "commands"

[[files]]
src = "agent-browser/config.json"
dest = "~/.agent-browser/config.json"

[git]
include = ["git/agent.gitconfig"]

[targets.amp]
agent = "generic"

[targets.amp.instances.main]
dir = "~/.amp"
roots = { instructions = "~/.amp/AGENTS.md", skills = "~/.amp/skills", commands = "~/.amp/commands" }
-- home/src/config/global/AGENTS.md --
Shared rules.
-- home/src/config/hosts/test.md --
Host rules.
-- home/src/config/skills/review/SKILL.md --
Review skill.
-- home/src/config/skills/notes/README.md --
Not a skill: no SKILL.md.
-- home/src/config/commands/deploy.md --
Deploy command.
-- home/src/config/agent-browser/config.json --
{"headless": true}
-- home/src/config/git/agent.gitconfig --
[alias]
	kitbag-st = status
-- local.json --
{"local": true}
-- want-agents.md --
<!-- Managed by kitbag. Edit the source in the configuration repository, not this file. -->

Shared rules.

Host rules.
-- home/dotfiles/tilde.gitconfig --
[include]
	path = ~/src/config/git/agent.gitconfig
-- want-tilde.gitconfig --
[include]
	path = ~/src/config/git/agent.gitconfig
-- home/dotfiles/plain.gitconfig --
[user]
	name = Dotfiles
-- want-plain.gitconfig --
[user]
	name = Dotfiles
-- machine.toml --
schema=1
[repo]
url="local-config"
path="~/src/config"
