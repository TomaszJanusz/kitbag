[!darwin] skip 'launchd CLI commands; systemd is covered by service.txtar'
env KITBAG_CONFIG=
env KITBAG_MODE=
env KITBAG_GIT_BACKEND=
env XDG_CONFIG_HOME=$HOME/.config
env XDG_STATE_HOME=$HOME/.local/state
env XDG_DATA_HOME=$HOME/.local/share
env OPENAI_API_KEY=service-secret-never-copy
env USER=testing
# launchd gets only the directories of git and ssh plus the system PATH.
env PATH=$WORK/bin:$WORK/not-a-tool-dir:$WORK/tools:$PATH
exec chmod +x bin/launchctl tools/ssh not-a-tool-dir/node
gitremote $WORK/config.git seed
exec kitbag init $WORK/config.git --yes

# Timer mode without starting: written, enabled, never bootstrapped.
exec kitbag service install --mode=timer --interval=5m --no-start
stdout 'Service installed/updated'
! stderr 'Linger'
exists $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
grep '<key>StartInterval</key><integer>300</integer>' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
! grep 'KeepAlive' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
! grep 'service-secret-never-copy' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
grep '<key>PATH</key><string>([^<]*:)?'$WORK'/tools:' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
grep '<key>PATH</key><string>[^<]*/usr/sbin:/sbin</string>' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
! grep 'not-a-tool-dir' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
! grep $WORK'/bin[:<]' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
grep 'launchctl enable gui/[0-9]+/dev.kitbag.agent' $HOME/commands
! grep 'bootstrap' $HOME/commands
! exists $HOME/.loaded
exec kitbag service status
stdout 'Service: installed=true loaded=false active=false enabled=true stale=false mode=timer'
stdout 'exit code: unknown'
stdout 'Last sync: unknown'

# The same installation is unchanged; --now bootstraps the unloaded job.
exec kitbag service install --mode=timer --interval=5m --now
stdout 'already installed and up to date'
grep 'launchctl bootstrap gui/[0-9]+ .*/Library/LaunchAgents/dev.kitbag.agent.plist' $HOME/commands
exists $HOME/.loaded
exec kitbag service status --json
stdout '"manager":"launchd"'
stdout '"installed":true'
stdout '"loaded":true'
stdout '"active":true'
stdout '"exit_code":0'
exec kitbag service status
stdout 'loaded=true active=true'
stdout 'exit code: 0'

# Status reports the persisted record of a manual sync.
exec kitbag sync
exec kitbag service status
stdout 'Last sync: \d{4}-\d\d-\d\d \d\d:\d\d:\d\d \S+ \(.+\); exit code: 0; 0 changed; '
! stdout 'Last sync: .*\dZ'
exec kitbag service status --json
stdout '"last_sync":\{"at":'
! stdout 'sync_error'

# A healthy job that has not exited yet: no exit code, not an error.
cp never $HOME/.never
exec kitbag service status
stdout 'loaded=true active=true'
stdout 'exit code: unknown'
exec kitbag service status --json
stdout '"exit_code":null'
exec kitbag doctor --json
! stdout 'cannot inspect user service'
! stdout 'exit_code='
stdout '"message": "loaded=true active=true enabled=true stale=false'
rm $HOME/.never

# A definition whose executable was removed (brew upgrade and cleanup) is explained.
cp $HOME/.local/state/kitbag/service.json $WORK/service.json.bak
cp missing-binary.json $HOME/.local/state/kitbag/service.json
exec kitbag service status
stdout 'Service executable /kitbag-removed/Cellar/kitbag/0.1.0/libexec/kitbag no longer exists.*run kitbag service refresh'
exec kitbag service status --json
stdout '"binary_missing":true'
exec kitbag doctor --json
stdout '"message": "service executable /kitbag-removed/Cellar/kitbag/0.1.0/libexec/kitbag no longer exists'
cp $WORK/service.json.bak $HOME/.local/state/kitbag/service.json
exec kitbag service status --json
stdout '"binary_missing":false'

localapi start
# Switching to daemon mode boots out the loaded job before replacing it.
exec kitbag service install --mode=daemon
stdout 'Service installed/updated'
grep 'launchctl bootout gui/[0-9]+/dev.kitbag.agent' $HOME/commands
grep '<key>KeepAlive</key><true/>' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
! grep 'StartInterval' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist

# Reinstalling a running daemon that never exited preserves the job and plist.
cp never $HOME/.never
cp $HOME/Library/LaunchAgents/dev.kitbag.agent.plist $WORK/daemon.plist
rm $HOME/commands
exec kitbag service install --mode=daemon
stdout 'already installed and up to date'
exec kitbag service install --mode=daemon
stdout 'already installed and up to date'
! grep 'launchctl (bootout|bootstrap|kickstart|disable)' $HOME/commands
cmp $HOME/Library/LaunchAgents/dev.kitbag.agent.plist $WORK/daemon.plist
exists $HOME/.loaded
exec kitbag service status --json
stdout '"loaded":true'
stdout '"active":true'
stdout '"exit_code":null'
exec kitbag doctor --json
stdout '"message": "loaded=true active=true enabled=true stale=false'
rm $HOME/.never

# Upgrade incident: an identical stable-path plist can still run the old process.
localapi stop
localapi start-old
rm $HOME/commands
exec kitbag service install
stdout 'Restarted the running daemon \(0.1.1 -> 0.0.0-dev\)'
grep 'launchctl bootout' $HOME/commands
grep 'launchctl bootstrap' $HOME/commands
cmp $HOME/Library/LaunchAgents/dev.kitbag.agent.plist $WORK/daemon.plist
exec kitbag service refresh
stdout 'Restarted the running daemon \(0.1.1 -> 0.0.0-dev\)'
localapi stop
localapi start-unversioned
rm $HOME/commands
exec kitbag service install
stdout 'Restarted the running daemon \(older -> 0.0.0-dev\)'
grep 'launchctl bootout' $HOME/commands
exec kitbag service refresh
stdout 'Restarted the running daemon \(older -> 0.0.0-dev\)'
cmp $HOME/Library/LaunchAgents/dev.kitbag.agent.plist $WORK/daemon.plist
localapi stop
localapi start
rm $HOME/commands
exec kitbag service install
stdout 'already installed and up to date'
exec kitbag service install
stdout 'already installed and up to date'
exec kitbag service refresh --json
stdout '"changed":false'
! grep 'launchctl (bootout|bootstrap|kickstart)' $HOME/commands

# Refresh must replace launchd's in-memory definition through bootout/bootstrap.
cp old-plist $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
execstatus 0 kitbag service refresh --json --dry-run
stdout '"definition_changed":true'
grep 'old service' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
execstatus 0 kitbag service refresh --json
stdout '"changed":true'
grep 'KeepAlive' $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
execstatus 0 kitbag service refresh --json
stdout '"changed":false'
localapi stop
exec kitbag service uninstall
stdout 'Configuration, working copies and sync state were kept'
grep 'launchctl disable gui/[0-9]+/dev.kitbag.agent' $HOME/commands
! exists $HOME/Library/LaunchAgents/dev.kitbag.agent.plist
! exists $HOME/.local/state/kitbag/service.json
! exists $HOME/.loaded
exists $HOME/.config/kitbag/config.toml
exists $HOME/.local/share/kitbag/repos/config/.git
exec kitbag service status
stdout 'installed=false loaded=false'

-- seed/kitbag.toml --
schema=1
-- never --
-- missing-binary.json --
{"environment":{},"binary":"/kitbag-removed/Cellar/kitbag/0.1.0/libexec/kitbag","config":"/kitbag-removed/config.toml","mode":"timer","log_dir":"/kitbag-removed/log","interval":300000000000}
-- tools/ssh --
#!/bin/sh
exit 0
-- not-a-tool-dir/node --
#!/bin/sh
exit 0
-- bin/launchctl --
#!/bin/sh
printf 'launchctl %s\n' "$*" >> "$HOME/commands"
case "$1" in
print)
  if [ ! -f "$HOME/.loaded" ]; then exit 113; fi
  if [ -f "$HOME/.never" ]; then printf 'state = running\n\tlast exit code = (never exited)\n'; exit 0; fi
  printf 'state = running\n\tlast exit code = 0\n';;
print-disabled)
  if [ -f "$HOME/.disabled" ]; then printf '\t"dev.kitbag.agent" => true\n'; fi;;
enable) rm -f "$HOME/.disabled";;
disable) touch "$HOME/.disabled";;
bootstrap) touch "$HOME/.loaded";;
kickstart) ;;
bootout) rm -f "$HOME/.loaded";;
*) exit 64;;
esac

-- old-plist --
<!-- old service -->
