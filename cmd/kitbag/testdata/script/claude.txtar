# Production Claude declarations, real apply engine, isolated HOME only.
gitremote $WORK/config.git config
exec git clone --quiet $WORK/config.git $WORK/checkout
agentdirs .claude .claude_2
cp local.json $HOME/.claude/settings.json
cp independent.json $HOME/.claude_2/settings.json
mkdir $HOME/.claude/skills
exec ln -s $WORK/removed $HOME/.claude/skills/synced

exec kitbag __e2e_apply --adapter claude $WORK/checkout
! stderr .
stdout '^merge .*/\.claude/settings.json$'
! stdout '\.claude_2/settings.json'
linktarget $HOME/.claude/skills/tool $WORK/checkout/skills/tool
linktarget $HOME/.claude_2/skills/tool $WORK/checkout/skills/tool
linktarget $HOME/.claude/commands/build.md $WORK/checkout/commands/build.md
linktarget $HOME/.claude_2/agents/reviewer.md $WORK/checkout/agents/reviewer.md
linktarget $HOME/.claude/hooks/check.sh $WORK/checkout/hooks/check.sh
linktarget $HOME/.claude/skills/synced $WORK/removed
grep '^@.*/checkout/global/AGENTS.md$' $HOME/.claude/CLAUDE.md
grep '^@.*/checkout/global/AGENTS.md$' $HOME/.claude_2/CLAUDE.md
grep 'foreign notifier' $HOME/.claude/settings.json
grep '# kitbag-managed' $HOME/.claude/settings.json
! grep '# agent-config-managed' $HOME/.claude/settings.json
cmp $HOME/.claude_2/settings.json independent.json
exec sh -c 'cp "$HOME"/.claude/settings.json.before-kitbag.* "$WORK"/original'
cmp $WORK/original local.json

# Repeat is silent, foreign hooks survive; removed managed hooks disappear.
exec kitbag __e2e_apply --adapter claude $WORK/checkout
nooutput
cp no-hooks.json $WORK/checkout/claude/settings.json
exec kitbag __e2e_apply --adapter claude $WORK/checkout
! stderr .
stdout '^merge .*/\.claude/settings.json$'
! grep '# kitbag-managed|old managed' $HOME/.claude/settings.json
grep 'foreign notifier' $HOME/.claude/settings.json
exec kitbag __e2e_apply --adapter claude $WORK/checkout
nooutput

# Opting out after a successful merge must preserve the owned file too.
cp $HOME/.claude/settings.json kept.json
cp settings-off.toml $WORK/checkout/kitbag.toml
exec kitbag __e2e_apply --adapter claude $WORK/checkout
nooutput
cmp $HOME/.claude/settings.json kept.json
cmp $HOME/.claude_2/settings.json independent.json

# A missing listed instance warns, other targets still sync, no dir is created.
cp enabled.toml $WORK/checkout/kitbag.toml
rm $HOME/.claude_2
execstatus 1 kitbag __e2e_apply --adapter claude $WORK/checkout
stderr 'instance directory is missing; skipped'
! exists $HOME/.claude_2

-- config/kitbag.toml --
schema = 1
[instructions]
source = "global/AGENTS.md"
[skills]
dirs = ["skills"]
[commands]
dir = "commands"
[agents]
dir = "agents"
[hooks]
dir = "hooks"
[targets.claude]
agent = "claude"
settings = "claude/settings.json"
[targets.claude.instances.main]
dir = "~/.claude"
[targets.claude.instances.second]
dir = "~/.claude_2"
settings = false
-- enabled.toml --
schema = 1
[instructions]
source = "global/AGENTS.md"
[skills]
dirs = ["skills"]
[commands]
dir = "commands"
[agents]
dir = "agents"
[hooks]
dir = "hooks"
[targets.claude]
agent = "claude"
settings = "claude/settings.json"
[targets.claude.instances.main]
dir = "~/.claude"
[targets.claude.instances.second]
dir = "~/.claude_2"
settings = false
-- settings-off.toml --
schema = 1
[instructions]
source = "global/AGENTS.md"
[skills]
dirs = ["skills"]
[commands]
dir = "commands"
[agents]
dir = "agents"
[hooks]
dir = "hooks"
[targets.claude]
agent = "claude"
settings = "claude/settings.json"
[targets.claude.instances.main]
dir = "~/.claude"
settings = false
[targets.claude.instances.second]
dir = "~/.claude_2"
settings = false
-- config/global/AGENTS.md --
Shared rules.
-- config/skills/tool/SKILL.md --
Tool skill.
-- config/commands/build.md --
Build the project.
-- config/agents/reviewer.md --
Review changes.
-- config/hooks/check.sh --
#!/bin/sh
exit 0
-- config/claude/settings.json --
{"theme":"dark","hooks":{"Stop":[{"hooks":[{"type":"command","command":"echo {repo}/hooks/check.sh"}]}]}}
-- no-hooks.json --
{"theme":"dark"}
-- local.json --
{"local":true,"hooks":{"Stop":[{"hooks":[{"type":"command","command":"foreign notifier"}]},{"hooks":[{"type":"command","command":"old managed # agent-config-managed"}]}]}}
-- independent.json --
{"theme":"independent","hooks":{"Stop":[{"hooks":[{"type":"command","command":"do not touch # agent-config-managed"}]}]}}
