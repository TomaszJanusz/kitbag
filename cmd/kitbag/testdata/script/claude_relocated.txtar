env KITBAG_CONFIG=$WORK/machine.toml
env KITBAG_HOST=test
# Default instance uses CLAUDE_CONFIG_DIR; an explicit instance ignores it.
gitremote $WORK/config.git config
exec git clone --quiet $WORK/config.git $HOME/checkout
env CLAUDE_CONFIG_DIR=$HOME/relocated
exec kitbag sync --no-pull
! stderr .
! exists $HOME/.claude
grep '^@.*/checkout/global/AGENTS.md$' $HOME/relocated/CLAUDE.md
exec kitbag sync --no-pull
nooutput

# Copy policy still writes generated imports and private settings as regular files.
cp listed.toml $HOME/checkout/kitbag.toml
agentdirs .listed
exec kitbag sync --no-pull --mode copy
! stderr .
! linktarget $HOME/.listed/skills/tool
content $HOME/.listed/skills/tool/SKILL.md 'Tool skill.'
! exists $HOME/.claude
exec kitbag sync --no-pull --mode copy
nooutput

-- config/kitbag.toml --
schema = 1
[instructions]
source = "global/AGENTS.md"
[skills]
dirs = ["skills"]
[targets.claude]
agent = "claude"
-- listed.toml --
schema = 1
[instructions]
source = "global/AGENTS.md"
[skills]
dirs = ["skills"]
[targets.claude]
agent = "claude"
[targets.claude.instances.main]
dir = "~/.listed"
-- config/global/AGENTS.md --
Shared rules.
-- config/skills/tool/SKILL.md --
Tool skill.
-- machine.toml --
schema=1
[repo]
url="local-config"
path="~/checkout"
