# All probes run against isolated HOME/config and a local file remote.
[windows] stop 'Windows refuses commands before 1.x'
env KITBAG_CONFIG=$WORK/machine.toml
env KITBAG_HOST=test
env CODEX_HOME=
env CLAUDE_CONFIG_DIR=
env SSH_AUTH_SOCK=
gitremote $WORK/config.git seed
exec git clone --quiet $WORK/config.git $HOME/checkout
exec git -C $HOME/checkout config user.name 'Doctor Test'
exec git -C $HOME/checkout config user.email test@example.invalid
exec git -C $HOME/checkout config commit.gpgsign false
hidecmd claude codex
exec kitbag doctor
stdout '^OK:$'
stdout '^WARN:$'
stdout '^FAIL:$'
stdout 'ssh-agent: .*fix: start an SSH agent and export SSH_AUTH_SOCK'
stdout 'agent-claude: .*fix: install claude'
stdout 'agent-codex: .*fix: install codex'
stdout 'instance-codex/first: .*fix: create or correct instance directory'
execstatus 1 kitbag doctor --strict
exec kitbag doctor --json
doctorschema stdout
stdout '"status": "WARN"'

# Both missing and regular-file socket paths warn.
env SSH_AUTH_SOCK=$WORK/plain
exec kitbag doctor
stdout 'SSH_AUTH_SOCK does not name a socket; fix: start an SSH agent'

# Remote failure is a FAIL, not a WARN or successful cached status.
exec git -C $HOME/checkout remote set-url origin $WORK/absent.git
execstatus 1 kitbag doctor
stdout 'remote: .*fix: check origin URL, connectivity and authentication'
exec git -C $HOME/checkout remote set-url origin $WORK/config.git

# Embedded diagnostics report safe provenance and actionable unsupported hints.
exec kitbag --git-backend=embedded doctor
stdout 'remote: remote reachability; credentials: none required'
mkdir $HOME/.ssh
cp unsupported-ssh $HOME/.ssh/config
exec git -C $HOME/checkout remote set-url origin ssh://fixture.invalid/repo
execstatus 1 kitbag --git-backend=embedded doctor
stdout 'remote: .*fix: install git or resolve in the working copy'
! stdout 'fixture.invalid'
exec git -C $HOME/checkout remote set-url origin $WORK/config.git
rm $HOME/.ssh/config

# Identity and signing are independent named checks and never print values.
exec git -C $HOME/checkout config user.name ''
exec git -C $HOME/checkout config commit.gpgsign true
exec git -C $HOME/checkout config user.signingkey ''
exec kitbag doctor
stdout 'commit-identity: .*fix: set git config user.name and user.email'
stdout 'commit-signing: .*fix: set git config user.signingkey'
! stdout 'test@example.invalid'

# A malformed Git boolean fails config inspection without exposing raw values.
exec git -C $HOME/checkout config commit.gpgsign invalid
exec kitbag doctor
stdout 'commit-config: .*fix: repair the working copy and Git config'
exec git -C $HOME/checkout config commit.gpgsign false

# Default instances honor relocation and explain invalid overrides.
cp default $HOME/checkout/kitbag.toml
env CODEX_HOME=relative
execstatus 1 kitbag doctor
stdout 'instances: .*fix: use absolute CODEX_HOME/CLAUDE_CONFIG_DIR'
env CODEX_HOME=
cp seed/kitbag.toml $HOME/checkout/kitbag.toml

# Invalid/future state cannot be silently replaced.
cp bad-state $HOME/.local/state/kitbag/state.json
execstatus 1 kitbag doctor
stdout 'state-health: .*fix: restore a valid state backup'
cmp bad-state $HOME/.local/state/kitbag/state.json
rm $HOME/.local/state/kitbag/state.json
# The test-only driver holds a real kernel lock while running public doctor.
execstatus 1 kitbag __e2e_doctor_locked doctor
stdout 'state-lock: .*another sync is running.*fix: wait for the running sync to exit'
cp plain $HOME/.local/state/kitbag/state.lock
# A leftover file is not a held lock.
exec kitbag doctor
stdout 'state-lock: state lock available'
rm $HOME/.local/state/kitbag/state.lock
mkdir $HOME/.local/state/kitbag/state.lock
execstatus 1 kitbag doctor
stdout 'state-lock: .*fix: wait for the running sync to exit'
rm $HOME/.local/state/kitbag/state.lock

# Cache filesystem failure exercises both materialization fix hints.
env XDG_CACHE_HOME=$WORK/plain
execstatus 1 kitbag doctor
stdout 'copy: .*fix: make the cache directory writable'
stdout 'link: .*fix: use --mode=copy'
env XDG_CACHE_HOME=
execstatus 1 kitbag --mode=invalid doctor
stdout 'materialization-mode: .*fix: select --mode=link or --mode=copy'

# Legacy detection is opt-in and never deletes or edits leftovers. Units of
# the native manager are inspected read-only through stand-ins (enabled and
# stopped here); the other manager's definitions are reported by presence.
env PATH=$WORK/bin:$PATH
exec chmod +x bin/systemctl bin/launchctl
cp enabled $HOME/.unit-state
agentdirs legacy .codex skills .config/systemd/user Library/LaunchAgents
exec ln -s $HOME/legacy/source $HOME/.codex/skills
# skills was not precreated under .codex.
cp marker $HOME/.codex/AGENTS.md
cp plain $HOME/.config/systemd/user/agent-config-sync.timer
cp plain $HOME/Library/LaunchAgents/com.example.agent-config-sync.plist
exec kitbag --config=$WORK/legacy.toml doctor
stdout 'legacy-links: .*fix: review old links and migrate/adopt'
stdout 'legacy-markers: .*fix: review legacy managed instructions'
stdout 'legacy-units: .*fix: disable and unload old agent-config-sync timers/services'
[linux] stdout 'legacy-units: .*systemd/user/agent-config-sync.timer \(loaded=false enabled=true\).*LaunchAgents/com.example.agent-config-sync.plist \(activation not queried\)'
[darwin] stdout 'legacy-units: .*systemd/user/agent-config-sync.timer \(activation not queried\).*LaunchAgents/com.example.agent-config-sync.plist \(loaded=false enabled=true\)'
[linux] grep '^--user show agent-config-sync.timer ' $HOME/.manager-calls
[darwin] grep '^print gui/[0-9]+/com.example.agent-config-sync$' $HOME/.manager-calls
! grep '(^| )(start|stop|enable|disable|bootstrap|bootout|kickstart)( |$)' $HOME/.manager-calls
linktarget $HOME/.codex/skills $HOME/legacy/source
cmp marker $HOME/.codex/AGENTS.md
exists $HOME/.config/systemd/user/agent-config-sync.timer

# A disabled, stopped native unit is no longer legacy (KIT-78).
cp disabled $HOME/.unit-state
exec kitbag --config=$WORK/legacy.toml doctor
[linux] stdout 'legacy-units: legacy timer/service definitions \(1 disabled and not loaded, ignored\): .*com.example.agent-config-sync.plist \(activation not queried\);'
[linux] ! stdout 'agent-config-sync\.timer'
[darwin] stdout 'legacy-units: legacy timer/service definitions \(1 disabled and not loaded, ignored\): .*agent-config-sync.timer \(activation not queried\);'
[darwin] ! stdout 'agent-config-sync\.plist'

# Legacy hook markers inside Claude settings are reported as a fact and count;
# the file is only searched, never echoed, parsed or written.
cp claude-seed/kitbag.toml $HOME/checkout/kitbag.toml
mkdir $HOME/.claude
exec kitbag --config=$WORK/legacy.toml doctor
stdout 'legacy-settings-markers: legacy hook markers in Claude settings.json'
! stdout 'legacy-settings-markers: .*fix:'
cp settings $HOME/.claude/settings.json
exec kitbag --config=$WORK/legacy.toml doctor
stdout 'legacy-settings-markers: .*claude/first: .*settings.json: 2 legacy hook marker occurrence\(s\); fix: run kitbag adopt, then kitbag sync; markers are migrated transparently, see docs/adopt.md'
! stdout 'FAKE_settings_secret'
execstatus 1 kitbag --config=$WORK/legacy.toml doctor --strict
exec kitbag --config=$WORK/legacy.toml doctor --json --report=$WORK/settings-report.json
doctorschema stdout
doctorschema settings-report.json
stdout '"id": "legacy-settings-markers"'
! stdout 'FAKE_settings_secret'
grep 'legacy-settings-markers' settings-report.json
grep '~/.claude/settings.json: 2 legacy hook marker' settings-report.json
! grep 'FAKE_settings_secret' settings-report.json
! grep $HOME settings-report.json
cmp settings $HOME/.claude/settings.json
rm $HOME/.claude/settings.json
cp seed/kitbag.toml $HOME/checkout/kitbag.toml

# Tool version failure exits 4 before any state lock or further probes.
cp future $HOME/checkout/kitbag.toml
execstatus 4 kitbag doctor
stdout 'tool-version: .*fix: upgrade kitbag'
! stdout 'state-lock:'
cp invalid $HOME/checkout/kitbag.toml
execstatus 1 kitbag doctor
stdout 'manifest: .*fix: configure repo.path and repair kitbag.toml'

# Backend failures are grouped diagnostics, not an early Cobra error.
hidecmd git
execstatus 1 kitbag --git-backend=system doctor
stdout 'git-backend: .*requested by --git-backend.*fix: install Git 2.30 or newer'
! stderr .

-- machine.toml --
schema=1
[repo]
url="local"
path="~/checkout"
-- legacy.toml --
schema=1
[repo]
url="local"
path="~/checkout"
[migration]
legacy_roots=["~/legacy"]
-- seed/kitbag.toml --
schema=1
[targets.codex]
agent="codex"
[targets.codex.instances.first]
dir="~/.codex"
-- claude-seed/kitbag.toml --
schema=1
[targets.claude]
agent="claude"
[targets.claude.instances.first]
dir="~/.claude"
-- settings --
{"apiKey":"FAKE_settings_secret","hooks":{"a":"run # agent-config-managed","b":"run # agent-config-managed"}}
-- default --
schema=1
[targets.codex]
agent="codex"
-- future --
schema=1
min_tool_version="99.0.0"
-- invalid --
this is not valid TOML
-- bad-state --
{"schema_version":99,"targets":[],"history":[]}
-- marker --
<!-- Managed by agent-config-sync -->
# agent-config-managed
-- plain --
plain
-- enabled --
enabled
-- disabled --
disabled
-- bin/systemctl --
#!/bin/sh
# Stand-in for systemctl --user show: $HOME/.unit-state selects the answer.
echo "$*" >> "$HOME/.manager-calls"
if [ "$(cat "$HOME/.unit-state")" = enabled ]; then
	printf 'LoadState=loaded\nActiveState=inactive\nUnitFileState=enabled\n'
else
	printf 'LoadState=loaded\nActiveState=inactive\nUnitFileState=disabled\n'
fi
-- bin/launchctl --
#!/bin/sh
# Stand-in for launchctl: no job is loaded; $HOME/.unit-state selects overrides.
echo "$*" >> "$HOME/.manager-calls"
case "$1" in
print) exit 113 ;;
print-disabled) printf '"com.example.agent-config-sync" => %s\n' "$(cat "$HOME/.unit-state")" ;;
esac

-- unsupported-ssh --
Host *
 ProxyJump fixture.invalid
