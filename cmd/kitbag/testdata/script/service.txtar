[!linux] skip 'systemd CLI commands; launchd is covered by injected-runner tests'
env KITBAG_CONFIG=
env KITBAG_MODE=
env KITBAG_GIT_BACKEND=
env XDG_CONFIG_HOME=$HOME/.config
env XDG_STATE_HOME=$HOME/.local/state
env XDG_DATA_HOME=$HOME/.local/share
env OPENAI_API_KEY=service-secret-never-copy
env USER=testing
env PATH=$WORK/bin:$PATH
exec chmod +x bin/systemctl bin/loginctl
gitremote $WORK/config.git seed
exec kitbag init $WORK/config.git --yes
exec kitbag service install --mode=timer --interval=5m --no-start
stdout 'Service installed/updated'
stderr 'Linger is disabled.*loginctl enable-linger testing'
exists $HOME/.config/systemd/user/dev.kitbag.agent.service
exists $HOME/.config/systemd/user/dev.kitbag.agent.timer
grep 'Type=oneshot' $HOME/.config/systemd/user/dev.kitbag.agent.service
grep 'OnUnitActiveSec=300s' $HOME/.config/systemd/user/dev.kitbag.agent.timer
! grep 'service-secret-never-copy' $HOME/.config/systemd/user/dev.kitbag.agent.service
# systemd keeps the installing shell's whole PATH (only launchd narrows it).
grep 'Environment="PATH='$WORK'/bin:' $HOME/.config/systemd/user/dev.kitbag.agent.service
! exists $HOME/.active
exec kitbag service status
stdout 'Service: installed=true loaded=true active=false enabled=true stale=false mode=timer'
stdout 'exit code: 0'
stdout 'Last sync: unknown'
exec kitbag service install --mode=timer --interval=5m --now
stdout 'already installed and up to date'
exists $HOME/.active
exec kitbag service status --json
stdout '"installed":true'
stdout '"active":true'
stdout '"exit_code":0'
# Status reports the persisted record of a manual sync.
exec kitbag sync
exec kitbag service status
stdout 'Last sync: \d{4}-\d\d-\d\d \d\d:\d\d:\d\d \S+ \(.+\); exit code: 0; 0 changed; '
! stdout 'Last sync: .*\dZ'
exec kitbag service status --json
stdout '"last_sync":\{"at":'
! stdout 'sync_error'
# A definition whose executable was removed (package upgrade) is explained.
cp $HOME/.local/state/kitbag/service.json $WORK/service.json.bak
cp missing-binary.json $HOME/.local/state/kitbag/service.json
exec kitbag service status
stdout 'Service executable /kitbag-removed/Cellar/kitbag/0.0.1/bin/kitbag no longer exists.*run kitbag service install'
exec kitbag service status --json
stdout '"binary":"/kitbag-removed/Cellar/kitbag/0.0.1/bin/kitbag"'
stdout '"binary_missing":true'
exec kitbag doctor --json
stdout '"message": "service executable /kitbag-removed/Cellar/kitbag/0.0.1/bin/kitbag no longer exists'
cp $WORK/service.json.bak $HOME/.local/state/kitbag/service.json
exec kitbag service status --json
stdout '"binary_missing":false'
! stdout 'no longer exists'
exec kitbag service install --mode=daemon
! exists $HOME/.config/systemd/user/dev.kitbag.agent.timer
grep 'Type=simple' $HOME/.config/systemd/user/dev.kitbag.agent.service
grep 'Restart=on-failure' $HOME/.config/systemd/user/dev.kitbag.agent.service
# A running service with an old check warns without another remote probe.
homefixture poll
exec kitbag doctor --json --report $WORK/poll-doctor.json
doctorschema stdout
stdout '"id": "daemon-poll",\n\s*"status": "WARN"'
stdout 'daemon is not checking; last check is older than three poll intervals'
stdout 'inspect kitbag service status and daemon logs; restart the user service'
# With no listening daemon, ordinary status labels the same record historical.
exec kitbag status
stdout 'Last check: .*ok \(stale; daemon not running\)'
! stdout 'Next check:'
exec kitbag status --json
stdout '"daemon_running": false'
stdout '"last_check": \{'
exec kitbag service uninstall
stdout 'Configuration, working copies and sync state were kept'
! exists $HOME/.config/systemd/user/dev.kitbag.agent.service
! exists $HOME/.config/systemd/user/dev.kitbag.agent.timer
! exists $HOME/.local/state/kitbag/service.json
exists $HOME/.config/kitbag/config.toml
exists $HOME/.local/share/kitbag/repos/config/.git
grep 'systemctl --user daemon-reload' $HOME/commands
grep 'systemctl --user enable dev.kitbag.agent.timer' $HOME/commands
grep 'systemctl --user stop dev.kitbag.agent.timer' $HOME/commands
grep 'systemctl --user disable dev.kitbag.agent.timer' $HOME/commands
exec kitbag service uninstall
exec kitbag service status
stdout 'installed=false loaded=false active=false enabled=false stale=false mode=$'
stdout 'exit code: unknown'
! exec kitbag service install --mode=bad
stderr 'service mode must be daemon or timer'
! exec kitbag service install --interval=0s
stderr 'service interval must be whole seconds'
! exec kitbag service install --now --no-start
stderr 'none of the others can be'

-- seed/kitbag.toml --
schema=1
-- missing-binary.json --
{"environment":{},"binary":"/kitbag-removed/Cellar/kitbag/0.0.1/bin/kitbag","config":"/kitbag-removed/config.toml","mode":"timer","log_dir":"/kitbag-removed/log","interval":300000000000}
-- bin/loginctl --
#!/bin/sh
printf 'Linger=no\n'
-- bin/systemctl --
#!/bin/sh
printf 'systemctl %s\n' "$*" >> "$HOME/commands"
case "$2" in
show)
  if [ ! -f "$HOME/.config/systemd/user/$3" ]; then printf 'LoadState=not-found\n'; exit 1; fi
  printf 'LoadState=loaded\n'
  if [ -f "$HOME/.active" ]; then printf 'ActiveState=active\n'; else printf 'ActiveState=inactive\n'; fi
  if [ -f "$HOME/.enabled" ]; then printf 'UnitFileState=enabled\n'; else printf 'UnitFileState=disabled\n'; fi
  printf 'ExecMainStartTimestamp=Sun 2026-10-25 12:00:00 UTC\nExecMainStatus=0\n';;
enable) touch "$HOME/.enabled";;
disable) rm -f "$HOME/.enabled";;
start) touch "$HOME/.active";;
stop) rm -f "$HOME/.active";;
esac
-- poll/.local/state/kitbag/last-check.json --
{"schema_version":1,"repository":"@HOME@/.local/share/kitbag/repos/config","at":"2020-01-01T00:00:00Z","next_at":"2020-01-01T00:01:00Z","interval_seconds":60,"outcome":"ok","head":"abc123"}
