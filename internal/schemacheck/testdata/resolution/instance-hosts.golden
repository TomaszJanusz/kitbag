# host ci
min_tool_version = ""
mode = ""
files = []
schema = 1

[targets]
  [targets.claude]
    agent = "claude"
    mode = "copy"
    settings = "claude/settings.json"
    [targets.claude.instances]
      [targets.claude.instances.main]
        dir = "~/.claude"
        mode = ""
      [targets.claude.instances.second]
        settings = false
        dir = "~/.claude_2"
        mode = ""
        hosts = ["mac", "ci"]
  [targets.codex]
    agent = "codex"
    mode = ""
    settings = ""
    [targets.codex.instances]
      [targets.codex.instances.work]
        enabled = false
        dir = "~/.codex-work"
        mode = ""
        hosts = ["runner02"]
