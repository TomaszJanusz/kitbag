[agents]
  dir = ""
  [agents.per_agent]
    claude = "claude/agents"

[hooks]
  dir = "hooks"

[rules]
  dir = "rules"
  [rules.per_agent]
    cursor = "cursor/rules"

[mcp]
  policy = "merge"
  [mcp.servers]
    [mcp.servers.docs]
      transport = "http"
      command = ""
      url = "https://docs.example.com/mcp"
      args = []
      secret_env = ["DOCS_TOKEN"]
      agents = []
      [mcp.servers.docs.headers]
        Accept = "application/json"
    [mcp.servers.linear]
      transport = ""
      command = "npx"
      url = ""
      args = ["-y", "@linear/mcp-server"]
      secret_env = ["LINEAR_API_KEY"]
      agents = ["claude", "codex"]
      [mcp.servers.linear.env]
        LOG_LEVEL = "warn"

[git]
  include = ["git/agent.gitconfig", "git/signing.gitconfig"]

[targets]
  [targets.amp]
    enabled = false
    agent = "generic"
    mode = ""
    settings = ""
    [targets.amp.instances]
      [targets.amp.instances.main]
        dir = "~/.config/amp"
        mode = ""
        [targets.amp.instances.main.roots]
          instructions = "~/.config/amp/AGENTS.md"
          skills = "~/.config/amp/skills"
        [targets.amp.instances.main.primitives]
          [targets.amp.instances.main.primitives.instructions]
            mode = ""
            render = "concat"
  [targets.claude]
    enabled = true
    agent = "claude"
    mode = "copy"
    settings = "claude/settings.json"
    [targets.claude.primitives]
      [targets.claude.primitives.instructions]
        mode = ""
        render = "import"
      [targets.claude.primitives.mcp]
        mode = "copy"
        render = ""
    [targets.claude.instances]
      [targets.claude.instances.only]
        dir = "~/.claude"
        mode = ""
  [targets.codex]
    agent = "codex"
    mode = ""
    settings = ""
    [targets.codex.instances]
      [targets.codex.instances.main]
        dir = "~/.codex"
        mode = ""
        [targets.codex.instances.main.roots]
          skills = "~/.agents/skills"

[publish]
  mode = "pr"
  branch = "main"
