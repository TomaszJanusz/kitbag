# Harness helpers: a throwaway HOME with agent directories, and assertions on
# symlink targets, file content and silent commands.

# HOME is $WORK/home; sections under home/ pre-populate it.
exec probe $HOME
stdout '^'${WORK@R}'/home$'
agentdirs .claude .codex .claude_2
exists $HOME/.codex
exists $HOME/.claude_2
content $HOME/.claude/settings.json '{}'

# linktarget checks the exact target, or only that the path is a symlink.
symlink $HOME/.codex/AGENTS.md -> $WORK/shared/AGENTS.md
linktarget $HOME/.codex/AGENTS.md $WORK/shared/AGENTS.md
linktarget $HOME/.codex/AGENTS.md
! linktarget $HOME/.codex/AGENTS.md $WORK/other/AGENTS.md
! linktarget $HOME/.claude/settings.json
! linktarget $HOME/.claude/missing.json

# content reads through symlinks; pair it with linktarget to check the mode.
content $HOME/.codex/AGENTS.md 'Shared rules.'
! content $HOME/.codex/AGENTS.md 'Other rules.'

# nooutput checks that the last command wrote nothing to stdout or stderr.
exec probe
nooutput
exec probe hello
! nooutput
exec probe -stderr warning
! nooutput


# hidecmd removes the PATH entries that hold a program; harness commands stay.
exec git --version
hidecmd git
! exec git --version
exec probe still here
stdout '^still here$'

# homefixture installs a recorded HOME with @HOME@ expanded, links included.
homefixture recorded
content $HOME/.codex/recorded.md 'Recorded in '$HOME'.'
linktarget $HOME/.agents/skills/tool $HOME/checkout/skills/tool
grep 'path = '$HOME'/checkout/git' $GIT_CONFIG_GLOBAL

# treesnap fingerprints a tree: equal bytes rewritten still differ (mtime).
treesnap $HOME before.snap .claude
cp $HOME/.claude/settings.json $HOME/.claude/other.json
treesnap $HOME same.snap .claude
cmp before.snap same.snap
cp $HOME/.codex/recorded.md $WORK/copy.md
cp $WORK/copy.md $HOME/.codex/recorded.md
treesnap $HOME rewritten.snap .claude
! cmp before.snap rewritten.snap
grep '^\.agents/skills/tool L.* -> '$HOME'/checkout/skills/tool$' before.snap

-- recorded/.codex/recorded.md --
Recorded in @HOME@.
-- recorded.links --
.agents/skills/tool -> @HOME@/checkout/skills/tool
-- recorded.gitconfig --
[include]
	path = @HOME@/checkout/git/agent.gitconfig
-- home/.claude/settings.json --
{}
-- shared/AGENTS.md --
Shared rules.
