{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitbag.sh/docs/api/api-v1.schema.json",
  "title": "KitBag local API v1",
  "description": "Authenticated newline-delimited JSON-RPC 2.0. Additional request fields are optional extensions. See local-api.md for framing, negotiation, permissions and drop policy.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/notification"
    }
  ],
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "api_version": {
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)$"
        },
        "options": {
          "type": "object",
          "properties": {
            "config": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "mode": {
              "type": "string"
            },
            "git_backend": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "config": {
          "type": "string"
        },
        "no_pull": {
          "type": "boolean"
        },
        "force": {
          "type": "boolean"
        },
        "agent": {
          "$ref": "#/$defs/agentChange"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Caller's agent relocation variables for agents.list; unknown names are ignored, nothing is stored."
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dry_run": {
          "type": "boolean"
        },
        "probe": {
          "type": "boolean"
        }
      },
      "required": [
        "token",
        "api_version"
      ],
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            -32700,
            -32600,
            -32601,
            -32602,
            -32603,
            -32000,
            -32001,
            -32002,
            -32003,
            -32004
          ]
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "exit_code": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "min_version": {
              "const": "1.0"
            },
            "max_version": {
              "const": "1.0"
            },
            "detail": {
              "type": "string",
              "description": "Why an agent change was refused (validation, layout, stale preview); names and ~/ paths only."
            }
          },
          "required": [
            "exit_code",
            "min_version",
            "max_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    "syncRecord": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string"
        },
        "result": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "at",
        "repository",
        "result",
        "changed"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "status_schema": {
          "const": 1
        },
        "repository": {
          "type": "string"
        },
        "git": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "upstream": {
              "type": "string"
            },
            "ahead": {
              "type": "integer",
              "minimum": 0
            },
            "behind": {
              "type": "integer",
              "minimum": 0
            },
            "dirty": {
              "type": "boolean"
            },
            "upstream_gone": {
              "type": "boolean"
            }
          },
          "required": [
            "branch",
            "commit",
            "upstream",
            "ahead",
            "behind",
            "dirty",
            "upstream_gone"
          ],
          "additionalProperties": false
        },
        "last_sync": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/syncRecord"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drift": {
          "type": "object",
          "properties": {
            "in sync": {
              "type": "integer",
              "minimum": 0
            },
            "update needed": {
              "type": "integer",
              "minimum": 0
            },
            "local drift": {
              "type": "integer",
              "minimum": 0
            },
            "conflict": {
              "type": "integer",
              "minimum": 0
            },
            "unmanaged obstacle": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "in sync",
            "update needed",
            "local drift",
            "conflict",
            "unmanaged obstacle"
          ],
          "additionalProperties": false
        },
        "last_check": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/checkRecord"
            }
          ]
        },
        "daemon_running": {
          "type": "boolean",
          "description": "True when the scheduling daemon answers. False makes last_check historical; never treat next_at as scheduled then. Older v1 servers may omit both new fields."
        },
        "daemon_version": {
          "type": "string",
          "description": "Version of the responding daemon, independent of API v1. Optional for older daemons."
        },
        "binary_version": {
          "type": "string",
          "description": "Optional local CLI enrichment; not the daemon version."
        },
        "service_stale": {
          "type": "boolean",
          "description": "Optional local CLI enrichment; not the daemon version."
        }
      },
      "required": [
        "status_schema",
        "repository",
        "git",
        "last_sync",
        "warnings",
        "drift"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "https://kitbag.sh/schemas/plan.schema.json"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "plan",
        "warnings"
      ],
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "exit_code",
        "changed"
      ],
      "additionalProperties": false
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "in sync",
              "update needed",
              "local drift",
              "conflict",
              "unmanaged obstacle"
            ]
          }
        },
        "required": [
          "path",
          "classification"
        ],
        "additionalProperties": false
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "config": {
          "type": "string"
        }
      },
      "required": [
        "config"
      ],
      "additionalProperties": false
    },
    "subscription": {
      "type": "object",
      "properties": {
        "subscribed": {
          "const": true
        }
      },
      "required": [
        "subscribed"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "properties": {
        "min_version": {
          "const": "1.0"
        },
        "max_version": {
          "const": "1.0"
        },
        "tool_version": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "const": [
            "status.get",
            "plan.get",
            "sync.run",
            "drift.list",
            "config.get",
            "config.set",
            "agents.list",
            "agents.add",
            "agents.edit",
            "agents.remove",
            "events.subscribe",
            "version.get"
          ]
        }
      },
      "required": [
        "min_version",
        "max_version",
        "tool_version",
        "methods"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": "1.0"
        },
        "kind": {
          "enum": [
            "sync.started",
            "sync.finished",
            "sync.progress",
            "drift.detected",
            "update.available",
            "poll.finished"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "phase": {
          "enum": [
            "started",
            "pull",
            "plan",
            "apply",
            "includes",
            "finished"
          ]
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "daemon_version": {
          "type": "string",
          "description": "Version of the responding daemon, independent of API v1. Optional for older daemons."
        }
      },
      "required": [
        "api_version",
        "kind",
        "exit_code",
        "changed"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "api_version": {
              "const": "1.0"
            },
            "data": {}
          },
          "required": [
            "api_version",
            "data"
          ],
          "additionalProperties": false
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "notification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "enum": [
            "sync.started",
            "sync.finished",
            "sync.progress",
            "drift.detected",
            "update.available",
            "poll.finished"
          ]
        },
        "params": {
          "$ref": "#/$defs/event"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "status_getRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "status.get"
            }
          }
        }
      ]
    },
    "plan_getRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "plan.get"
            }
          }
        }
      ]
    },
    "sync_runRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "sync.run"
            }
          }
        }
      ]
    },
    "drift_listRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "drift.list"
            }
          }
        }
      ]
    },
    "config_getRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "config.get"
            }
          }
        }
      ]
    },
    "config_setRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "config.set"
            }
          }
        }
      ]
    },
    "events_subscribeRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "events.subscribe"
            }
          }
        }
      ]
    },
    "version_getRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "properties": {
            "method": {
              "const": "version.get"
            }
          }
        }
      ]
    },
    "checkRecord": {
      "type": "object",
      "description": "Latest completed daemon check; timestamps are UTC RFC 3339. next_at is the actual jittered/backoff schedule and is historical when daemon_running is false.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "next_at": {
          "type": "string",
          "format": "date-time"
        },
        "repository": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "ok",
            "failed"
          ]
        },
        "category": {
          "enum": [
            "operation",
            "busy",
            "invalid",
            "conflict",
            "tool_too_old",
            "unsupported_os",
            "canceled"
          ]
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{0,12}$"
        },
        "interval_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "schema_version",
        "at",
        "next_at",
        "repository",
        "outcome",
        "interval_seconds"
      ],
      "additionalProperties": false
    },
    "agentChange": {
      "type": "object",
      "description": "An instance change; the method sets op. add needs kind, name and dir; edit and remove need target (a target, or a kind with one target) and name. hosts limits the instance to those hosts (the instance's hosts key in kitbag.toml) and all_hosts (edit) removes the limit; without either, add applies to every host and edit keeps the current hosts. Daemons before this field ignore it, so check the preview's change.hosts.",
      "properties": {
        "op": {
          "enum": [
            "add",
            "edit",
            "remove"
          ]
        },
        "kind": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          }
        },
        "all_hosts": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "agentCandidate": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "source": {
          "enum": [
            "default",
            "environment",
            "declared",
            "probe"
          ]
        },
        "variable": {
          "type": "string"
        },
        "presence": {
          "enum": [
            "present",
            "missing",
            "not_directory",
            "symlink",
            "outside_home",
            "unreadable"
          ]
        },
        "error_class": {
          "enum": [
            "permission",
            "io"
          ]
        }
      },
      "required": [
        "kind",
        "dir",
        "source",
        "presence"
      ],
      "additionalProperties": true
    },
    "agents": {
      "type": "object",
      "description": "agents_schema 1, as kitbag agent list --json (schemas/agents.schema.json).",
      "properties": {
        "agents_schema": {
          "const": 1
        },
        "host": {
          "type": "string"
        },
        "known_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/agentCandidate"
              },
              {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "hosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "excluded_hosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "implicit": {
                    "type": "boolean"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "settings": {
                    "type": "boolean"
                  },
                  "active_here": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "target",
                  "name",
                  "hosts",
                  "excluded_hosts",
                  "implicit",
                  "enabled",
                  "settings",
                  "active_here"
                ]
              }
            ]
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentCandidate"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "agents_schema",
        "host",
        "known_hosts",
        "kinds",
        "instances",
        "candidates",
        "warnings",
        "schema"
      ],
      "additionalProperties": false
    },
    "agentChangeResult": {
      "type": "object",
      "description": "agent_change_schema 1, as kitbag agent add/edit/remove --json (schemas/agent-change.schema.json).",
      "properties": {
        "agent_change_schema": {
          "const": 1
        },
        "dry_run": {
          "type": "boolean"
        },
        "manifest": {
          "type": "string"
        },
        "revision_after": {
          "type": "string"
        },
        "plan": {
          "type": "object",
          "properties": {
            "change": {
              "$ref": "#/$defs/agentChange"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "title": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "dropped_dir": {
              "type": "string"
            },
            "diff": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "change",
            "revision",
            "title",
            "message",
            "diff",
            "warnings"
          ],
          "additionalProperties": false
        },
        "publication": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "dry_run",
                "published",
                "not_published",
                "manual",
                "conflict"
              ]
            },
            "mode": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "next": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "state",
            "mode",
            "branch",
            "next",
            "attempts"
          ],
          "additionalProperties": false
        },
        "released": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "dir": {
                  "type": "string"
                },
                "changed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "dir",
                "changed",
                "warnings"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sync": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "exit_code": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "changed": {
                  "type": "integer",
                  "minimum": 0
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "exit_code",
                "changed",
                "warnings"
              ],
              "additionalProperties": false
            }
          ]
        },
        "effects": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "existing"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
